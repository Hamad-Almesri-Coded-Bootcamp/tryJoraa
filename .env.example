# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# The lead shares the real values directly, never in the repo and never in a PR.
#
# Three of these are LEAD-ONLY and are never sent to a teammate:
# SUPABASE_SERVICE_ROLE_KEY, N8N_API_KEY, N8N_WEBHOOK_SECRET.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. LEAD ONLY. Used by scripts/seed-auth.ts (creating auth users
# needs it) and by n8n. It appears NOWHERE in scripts/verify-rls.ts, which runs
# on the anon key only. Never prefix this NEXT_PUBLIC_, never import it into a
# client component, never log it, never paste it into a chat. CI does not have it.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n --------------------------------------------------------------------
# LEAD ONLY. n8n Cloud → Settings → API → create an API key. This is what lets
# Claude create, update and activate the workflow from code instead of somebody
# clicking in the canvas.
N8N_BASE_URL=https://<your-instance>.app.n8n.cloud
N8N_API_KEY=

# Written by PROMPT 0 by reading it back from the ACTIVATED orchestrator
# workflow — do not paste this by hand. It must contain /webhook/ and never /webhook-test/. The
# test URL only listens for 120 seconds with the editor open, and the judge
# closes n8n before pressing our button.
N8N_WEBHOOK_URL=

# LEAD ONLY. Shared secret sent as a header by /api/runs and checked by the
# workflow, so nobody else can trigger runs.
N8N_WEBHOOK_SECRET=

# --- RLS test accounts ------------------------------------------------------
# FOUR throwaway accounts created by scripts/seed-auth.ts — two patients and two
# doctors. Used only by scripts/verify-rls.ts and npm run verify:ui. These are
# not demo accounts — do not seed them with demo data, do not show them on stage.
#
# The two doctors exist because PRODUCT-DECISIONS.md D25 made a prescription
# readable by any doctor LINKED to the patient through doctor_patients. That rule
# is only proved by testing both sides of the link: the linked doctor must read
# patient A's rows, and the unlinked doctor must read nothing at all.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=

# Linked to RLS_TEST_A through doctor_patients. Reads A, never B.
RLS_TEST_DOCTOR_LINKED_EMAIL=
RLS_TEST_DOCTOR_LINKED_PASSWORD=

# Linked to nobody. Must read nothing, on every table.
RLS_TEST_DOCTOR_UNLINKED_EMAIL=
RLS_TEST_DOCTOR_UNLINKED_PASSWORD=

# --- Deployed URL -----------------------------------------------------------
# The public Vercel URL. verify:ui runs against this, not against localhost —
# a check that passes locally and fails in production is worth nothing on
# Thursday.
PUBLIC_SITE_URL=
