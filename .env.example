# Variable NAMES only. Never put a real value in this file — it is committed.
# Real values go in .env (git-ignored) and in the Vercel project settings.

# Safe in the browser. Protected by row level security, not by secrecy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER in this repo, in any form, in any branch, in any commit.
# The service-role key bypasses row level security entirely.
# It lives in n8n credentials only.
# SUPABASE_SERVICE_ROLE_KEY=
